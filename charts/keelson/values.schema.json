{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["upstream", "argocd"],
  "$comment": "Unknown top-level keys are rejected. A new top-level values key must be declared here.",
  "additionalProperties": false,
  "$defs": {
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "secretRef"],
      "properties": {
        "type": { "type": "string", "enum": ["oidc", "microsoft", "github"] },
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 63, "description": "Unique. Also names the Dex env vars." },
        "name": { "type": "string", "minLength": 1, "description": "Login button text. Default: id." },
        "secretRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "description": "Secret in namespace auth. A name only." },
            "clientIDKey": { "type": "string", "minLength": 1, "default": "clientID" },
            "clientSecretKey": { "type": "string", "minLength": 1, "default": "clientSecret" }
          }
        },
        "issuer": { "type": "string", "pattern": "^https?://[^\\s]+$" },
        "scopes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "groupsClaim": { "type": "string", "minLength": 1, "default": "groups" },
        "tenant": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}|[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+)$",
          "not": { "pattern": "(?i)^(common|consumers|organizations)$" },
          "description": "microsoft: tenant ID or verified domain. Multi-tenant values accept any account and drop groups."
        },
        "allowedGroups": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "microsoft: only members may log in." },
        "onlySecurityGroups": { "type": "boolean", "default": false },
        "groupNameFormat": { "type": "string", "enum": ["name", "id"], "default": "name" },
        "emailToLowercase": { "type": "boolean", "default": true, "description": "microsoft: Kubeflow compares user emails case-sensitively." },
        "orgs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": { "name": { "type": "string", "minLength": 1 }, "teams": { "type": "array", "items": { "type": "string", "minLength": 1 } } }
          },
          "description": "github: required, so arbitrary GitHub users can't log in."
        },
        "teamNameField": { "type": "string", "enum": ["name", "slug", "both"], "default": "slug" },
        "loadAllGroups": { "type": "boolean", "default": false },
        "useLoginAsID": { "type": "boolean", "default": false },
        "extraConfig": {
          "type": "object",
          "propertyNames": { "not": { "pattern": "(?i)secret|password|token|key" } },
          "description": "Unsupported. Merged last into the connector config. No secret-like keys."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "oidc" } } },
          "then": { "required": ["issuer"], "propertyNames": { "not": { "enum": ["tenant", "allowedGroups", "onlySecurityGroups", "groupNameFormat", "emailToLowercase", "orgs", "teamNameField", "loadAllGroups", "useLoginAsID"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "microsoft" } } },
          "then": {
            "required": ["tenant"],
            "propertyNames": { "not": { "enum": ["issuer", "scopes", "groupsClaim", "orgs", "teamNameField", "loadAllGroups", "useLoginAsID"] } },
            "properties": { "extraConfig": { "propertyNames": { "not": { "enum": ["tenant", "groups", "useGroupsAsWhitelist"] } } } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "github" } } },
          "then": {
            "required": ["orgs"],
            "propertyNames": { "not": { "enum": ["issuer", "scopes", "groupsClaim", "tenant", "allowedGroups", "onlySecurityGroups", "groupNameFormat", "emailToLowercase"] } },
            "properties": { "extraConfig": { "propertyNames": { "not": { "enum": ["orgs", "org", "hostName", "rootCA"] } } } }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "required": ["environment"], "properties": { "environment": { "const": "production" } } },
      "then": {
        "required": ["auth"],
        "properties": {
          "auth": {
            "required": ["staticUsers", "dex"],
            "properties": {
              "staticUsers": { "required": ["enabled"], "properties": { "enabled": { "const": false } } },
              "dex": { "required": ["connectors"], "properties": { "connectors": { "minItems": 1 } } }
            }
          }
        }
      }
    },
    {
      "if": { "required": ["auth"], "properties": { "auth": { "required": ["staticUsers"], "properties": { "staticUsers": { "required": ["enabled"], "properties": { "enabled": { "const": false } } } } } } },
      "then": { "properties": { "auth": { "required": ["dex"], "properties": { "dex": { "required": ["connectors"], "properties": { "connectors": { "minItems": 1 } } } } } } }
    },
    {
      "if": { "required": ["auth"], "properties": { "auth": { "required": ["dex"], "properties": { "dex": { "required": ["connectors"], "properties": { "connectors": { "minItems": 1 } } } } } } },
      "then": { "required": ["domain"], "properties": { "domain": { "minLength": 1 } } }
    },
    {
      "if": { "required": ["tls"], "properties": { "tls": { "required": ["issuer"], "properties": { "issuer": { "const": "existing" } } } } },
      "then": {
        "required": ["domain"],
        "properties": {
          "domain": { "minLength": 1 },
          "tls": { "required": ["secretRef"], "properties": { "secretRef": { "required": ["name"], "properties": { "name": { "minLength": 1 } } } } }
        }
      }
    },
    {
      "if": { "required": ["tls"], "properties": { "tls": { "required": ["issuer"], "properties": { "issuer": { "const": "external" } } } } },
      "then": { "required": ["domain"], "properties": { "domain": { "minLength": 1 } } }
    }
  ],
  "properties": {
    "global": { "type": "object", "description": "Helm global values. Allowed so parent charts and --set global.* keep working." },
    "profiles": { "type": "array", "description": "Placeholder; defined by #9" },
    "storage": { "type": "object", "description": "Placeholder; defined by #12 and #38" },
    "database": { "type": "object", "description": "Placeholder; defined by #12 and #39" },
    "policy": { "type": "object", "description": "Placeholder; defined by #11" },
    "upstream": {
      "type": "object",
      "required": ["manifestsRepo", "manifestsRef"],
      "properties": {
        "manifestsRepo": { "type": "string", "format": "uri" },
        "manifestsRef": {
          "type": "string",
          "pattern": "^[0-9]{2}\\.[0-9]{2}(\\.[0-9]+)?$",
          "description": "Pinned kubeflow/manifests release tag, e.g. 26.10.0. Branches and HEAD are not allowed."
        }
      }
    },
    "platform": {
      "type": "string",
      "enum": ["generic", "kind"],
      "default": "generic",
      "description": "Cluster type. Selects platform-specific upstream overlays (source.platformPaths)."
    },
    "domain": {
      "type": "string",
      "anyOf": [{ "maxLength": 0 }, { "maxLength": 253, "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$" }],
      "description": "Hostname for Kubeflow, no scheme, lowercase only (e.g. kubeflow.example.com). Empty keeps the upstream default: Gateway hosts \"*\", HTTP."
    },
    "environment": {
      "type": "string",
      "enum": ["dev", "production"],
      "default": "dev",
      "description": "production rejects auth.staticUsers and needs at least one Dex connector."
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "staticUsers": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean", "description": "Upstream static user user@example.com. Kind and dev only." } }
        },
        "dex": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "connectors": { "type": "array", "items": { "$ref": "#/$defs/connector" } } }
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "type": "string",
          "enum": ["none", "existing", "external"],
          "default": "none",
          "description": "none: HTTP. existing: Istio terminates TLS with secretRef. external: TLS ends in front of the cluster; cookies are secure."
        },
        "secretRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "description": "kubernetes.io/tls Secret in istio-system (issuer=existing). A name only, never key material." }
          }
        }
      }
    },
    "argocd": {
      "type": "object",
      "required": ["namespace", "project", "destinationServer"],
      "additionalProperties": false,
      "properties": {
        "namespace": { "type": "string", "minLength": 1 },
        "project": { "type": "string", "minLength": 1 },
        "destinationServer": { "type": "string", "format": "uri" },
        "extraSourceRepos": {
          "type": "array",
          "items": { "type": "string", "format": "uri" },
          "description": "Extra repos allowed in the AppProject, after upstream.manifestsRepo."
        }
      }
    },
    "modules": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9-]+$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "enabled": { "type": "boolean" } }
      },
      "description": "Per-module switches keyed by module name. Unknown names fail at render time."
    },
    "advanced": {
      "type": "object",
      "properties": {
        "modules": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9-]+$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "appSpecOverride": {
                "type": "object",
                "description": "Unsupported. Deep-merged over the generated Application spec."
              }
            }
          }
        }
      }
    }
  }
}
